.header_nav{ margin-top:20px; text-align:right;}
.header_nav ul{ list-style:none;}
.header_nav ul li{ list-style:none; display:inline; color:#000000;}
.header_nav ul li a{ color:#000000; display:inline; font-family:Arial, Helvetica, sans-serif; font-size:12px; padding:5px 12px;text-decoration:none; }
.header_nav ul li a:hover{ color:#ffffff; text-decoration:underline; }
